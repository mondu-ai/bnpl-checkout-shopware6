{% block mondu_async_order_fields %}
<mt-card
    class="mondu-async-order-fields"
    position-identifier="mondu-async-order-fields"
    :title="$t('sw-order-mondu.asyncOrder.title')"
>
    <p class="mondu-async-order-fields__description">
        {{ $t('sw-order-mondu.asyncOrder.description') }}
    </p>

    <mt-banner
        v-if="config.company && !config.company.name"
        variant="critical"
        class="mondu-async-order-fields__no-company"
    >
        {{ $t('sw-order-mondu.asyncOrder.noCompany') }}
    </mt-banner>
    <p
        v-else-if="config.company"
        class="mondu-async-order-fields__company"
    >
        {{ $t('sw-order-mondu.asyncOrder.labelCompany') }}: <strong>{{ config.company.name }}</strong>
    </p>

    <mt-banner
        v-if="showNoNetTerms"
        variant="critical"
        class="mondu-async-order-fields__no-net-terms"
    >
        {{ $t('sw-order-mondu.asyncOrder.noNetTerms') }}
    </mt-banner>

    <sw-container
        columns="1fr 1fr"
        gap="0px 30px"
    >
        <mt-select
            v-if="isVisible('net_term') && netTermOptions.length"
            class="mondu-async-order-fields__net-term"
            :model-value="values.net_term"
            :options="netTermOptions"
            :label="$t('sw-order-mondu.asyncOrder.labelNetTerm')"
            :required="isRequired('net_term')"
            @update:model-value="onChange('net_term', $event)"
        />

        <mt-select
            v-if="isVisible('number_of_installments')"
            class="mondu-async-order-fields__number-of-installments"
            :model-value="values.number_of_installments"
            :options="installmentOptions"
            :label="$t('sw-order-mondu.asyncOrder.labelNumberOfInstallments')"
            :required="isRequired('number_of_installments')"
            @update:model-value="onChange('number_of_installments', $event)"
        />

        <mt-text-field
            v-if="isVisible('iban')"
            class="mondu-async-order-fields__iban"
            :model-value="values.iban"
            :label="$t('sw-order-mondu.asyncOrder.labelIban')"
            :required="isRequired('iban')"
            @update:model-value="onChange('iban', $event)"
        />

        <mt-text-field
            v-if="isVisible('account_holder')"
            class="mondu-async-order-fields__account-holder"
            :model-value="values.account_holder"
            :label="$t('sw-order-mondu.asyncOrder.labelAccountHolder')"
            :required="isRequired('account_holder')"
            @update:model-value="onChange('account_holder', $event)"
        />

        <mt-text-field
            v-if="isVisible('registration_id')"
            class="mondu-async-order-fields__registration-id"
            :model-value="values.registration_id"
            :label="$t('sw-order-mondu.asyncOrder.labelRegistrationId')"
            :help-text="config.registrationIdHint || null"
            :required="isRequired('registration_id')"
            @update:model-value="onChange('registration_id', $event)"
        />

        <mt-select
            v-if="isVisible('legal_form_category')"
            class="mondu-async-order-fields__legal-form-category"
            :model-value="values.legal_form_category"
            :options="legalFormCategoryOptions"
            :label="$t('sw-order-mondu.asyncOrder.labelLegalFormCategory')"
            :required="isRequired('legal_form_category')"
            @update:model-value="onChange('legal_form_category', $event)"
        />

        <mt-text-field
            v-if="isVisible('owner_first_name')"
            class="mondu-async-order-fields__owner-first-name"
            :model-value="values.owner_first_name"
            :label="$t('sw-order-mondu.asyncOrder.labelOwnerFirstName')"
            :required="isRequired('owner_first_name')"
            @update:model-value="onChange('owner_first_name', $event)"
        />

        <mt-text-field
            v-if="isVisible('owner_last_name')"
            class="mondu-async-order-fields__owner-last-name"
            :model-value="values.owner_last_name"
            :label="$t('sw-order-mondu.asyncOrder.labelOwnerLastName')"
            :required="isRequired('owner_last_name')"
            @update:model-value="onChange('owner_last_name', $event)"
        />

        <mt-datepicker
            v-if="isVisible('owner_birth_date')"
            class="mondu-async-order-fields__owner-birth-date"
            date-type="date"
            :model-value="values.owner_birth_date || null"
            :label="$t('sw-order-mondu.asyncOrder.labelOwnerBirthDate')"
            :required="isRequired('owner_birth_date')"
            @update:model-value="onBirthDateChange"
        />
    </sw-container>
</mt-card>
{% endblock %}
